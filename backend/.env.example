# ============================================
# 后端环境变量示例 - 复制为 .env 后填入实际值
# ============================================
# 注意：.env 文件已在 .gitignore 中，不会被提交到代码仓库

# 千问 API Key（必需）
# 申请地址：https://dashscope.aliyuncs.com/apiKey
DASHSCOPE_API_KEY=sk-your-real-api-key-here

# 千问 API Base URL（可选，海外版或代理可改）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode

# JWT 签名密钥（生产环境必须改，建议 64+ 字符随机）
# 生成方式：openssl rand -base64 64
JWT_SECRET=your-strong-secret-key-at-least-32-bytes-long-recommended

# =================================================================
# AI Drone Rental Platform - 环境变量模板
# 复制此文件为 .env.development（开发） / .env.production（生产）
# =================================================================

# API 基础地址
# 留空时：Web 端用 /api（走 vite proxy）；Uniapp 端用 http://localhost:8080/api
# 推荐：HBuilderX 跑 Uniapp 时显式填 http://<你的后端IP>:8080/api
VITE_API_BASE_URL=

# 是否启用前端 mock 拦截（仅 Uniapp 端生效，Web 端不会拦截）
#   true  - 所有请求走本地 mock 数据，**不调用真实后端**（开发 demo 用）
#   false - 调用真实后端（默认）
VITE_USE_MOCK=false

# =================================================================
# AI Drone Rental Platform - 环境变量模板
# 复制此文件为 .env.development（开发） / .env.production（生产）
# =================================================================

# API 基础地址
# 留空时：默认使用 http://localhost:8080/api
# HBuilderX 调试时：推荐填 http://<你的后端IP>:8080/api（如 http://192.168.1.100:8080/api）
# 真机调试：必须填局域网内后端的 IP，不能用 localhost
# 微信小程序：必须配置 request 合法域名（小程序后台 → 开发管理 → 服务器域名）
VITE_API_BASE_URL=

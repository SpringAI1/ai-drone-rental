<template>
  <view class="fault-page">
    <!-- 顶部栏 -->
    <view class="fault-header">
      <text class="header-title">故障报修</text>
      <text class="header-sub">上报您遇到的设备问题</text>
    </view>

    <!-- 表单区 -->
    <view class="form-card">
      <view class="form-item" @click="showOrderPicker = true">
        <text class="form-label">关联订单 <text class="required">*</text></text>
        <view class="form-value">
          <text v-if="selectedOrder" class="value-text">{{ selectedOrder.orderNo }} · {{ selectedOrder.droneName }}</text>
          <text v-else class="value-placeholder">请选择租赁订单</text>
          <text class="arrow">›</text>
        </view>
      </view>

      <view class="form-item" @click="showTypePicker = true">
        <text class="form-label">故障类型 <text class="required">*</text></text>
        <view class="form-value">
          <text v-if="faultType" class="value-text">{{ faultType }}</text>
          <text v-else class="value-placeholder">请选择故障类型</text>
          <text class="arrow">›</text>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">故障发生日期</text>
        <picker mode="date" :value="faultDate" @change="onDateChange">
          <view class="picker-row">
            <text class="picker-text" :class="{ placeholder: !faultDate }">
              {{ faultDate || '请选择日期' }}
            </text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">故障发生时间</text>
        <picker mode="time" :value="faultTime" @change="onTimeChange">
          <view class="picker-row">
            <text class="picker-text" :class="{ placeholder: !faultTime }">
              {{ faultTime || '请选择时间' }}
            </text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">问题描述 <text class="required">*</text></text>
        <textarea
          class="form-textarea"
          v-model="description"
          placeholder="请详细描述故障情况，例如：飞行不稳定、图像传输异常、电池续航明显下降等"
          maxlength="500"
        />
        <text class="counter">{{ description.length }}/500</text>
      </view>

      <view class="form-item">
        <text class="form-label">上传图片(选填，最多 9 张)</text>
        <view class="image-grid">
          <view
            v-for="(img, index) in images"
            :key="'img-' + index"
            class="image-item"
          >
            <image class="uploaded-img" :src="img" mode="aspectFill" />
            <view class="remove-btn" @click="removeImage(index)">
              <text class="remove-text">×</text>
            </view>
          </view>
          <view
            v-if="images.length < 9"
            class="image-item add-item"
            @click="chooseImage"
          >
            <text class="add-icon">+</text>
            <text class="add-text">添加图片</text>
          </view>
        </view>
      </view>
    </view>

    <view class="submit-box">
      <view
        class="submit-btn"
        :class="{ disabled: submitting }"
        @click="handleSubmit"
      >
        <text class="submit-text">{{ submitting ? '提交中...' : '提交报修' }}</text>
      </view>
    </view>

    <!-- 我的报修记录 -->
    <view class="record-card" v-if="records.length > 0">
      <view class="record-title-row">
        <text class="record-title">我的报修记录</text>
        <text class="record-total">共 {{ records.length }} 条</text>
      </view>
      <view
        class="record-item"
        v-for="item in records"
        :key="item.id"
      >
        <view class="record-header-row">
          <text class="record-name">{{ item.faultType }}</text>
          <view class="status-tag" :class="'status-' + item.status">
            <text class="status-text">{{ getStatusText(item.status) }}</text>
          </view>
        </view>
        <text class="record-info" v-if="item.orderNo">订单号：{{ item.orderNo }}</text>
        <text class="record-info" v-if="item.droneName">无人机：{{ item.droneName }}</text>
        <text class="record-info" v-if="item.faultDescription">{{ item.faultDescription }}</text>
        <text class="record-time" v-if="item.createdTime">{{ formatTime(item.createdTime) }} 提交</text>
      </view>
    </view>

    <!-- 订单选择弹窗 -->
    <view v-if="showOrderPicker" class="modal-mask" @click="showOrderPicker = false">
      <view class="modal-content" @click.stop>
        <view class="modal-header">
          <text class="modal-title">选择关联订单</text>
          <text class="modal-close" @click="showOrderPicker = false">×</text>
        </view>
        <view class="modal-list" v-if="orders.length > 0">
          <view
            class="modal-item"
            v-for="order in orders"
            :key="order.id"
            @click="selectOrder(order)"
          >
            <text class="item-title">{{ order.orderNo }}</text>
            <text class="item-sub">{{ order.droneName }} · {{ order.status }}</text>
          </view>
        </view>
        <view class="modal-empty" v-else>
          <text class="empty-text">暂无订单，请到订单列表查看</text>
        </view>
      </view>
    </view>

    <!-- 故障类型选择弹窗 -->
    <view v-if="showTypePicker" class="modal-mask" @click="showTypePicker = false">
      <view class="modal-content" @click.stop>
        <view class="modal-header">
          <text class="modal-title">选择故障类型</text>
          <text class="modal-close" @click="showTypePicker = false">×</text>
        </view>
        <view class="modal-list">
          <view
            class="modal-item"
            v-for="(t, i) in faultTypeList"
            :key="'type-' + i"
            @click="selectType(t)"
          >
            <text class="item-title">{{ t }}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-space"></view>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue'
import { reportFault, getFaultList } from '../../api/fault'
import { getOrderList } from '../../api/order'

const selectedOrder = ref<any>(null)
const faultType = ref<string>('')
const description = ref<string>('')
const images = ref<string[]>([])
const faultDate = ref<string>('')
const faultTime = ref<string>('')
const submitting = ref<boolean>(false)
const showOrderPicker = ref<boolean>(false)
const showTypePicker = ref<boolean>(false)
const orders = ref<any[]>([])
const records = ref<any[]>([])

const faultTypeList = ref<string[]>([
  '飞行不稳定',
  '电池续航异常',
  '摄像头无法拍摄',
  '图像传输异常',
  '遥控器故障',
  '螺旋桨损坏',
  '机身碰撞损坏',
  'GPS 定位异常',
  '充电异常',
  '其他问题'
])

const onDateChange = (e: any) => {
  faultDate.value = e.detail.value
}

const onTimeChange = (e: any) => {
  faultTime.value = e.detail.value
}

const getStatusText = (status: number): string => {
  if (status === 0) return '待处理'
  if (status === 1) return '处理中'
  if (status === 2) return '已解决'
  if (status === 3) return '已拒绝'
  return '未知'
}

const formatTime = (t: string): string => {
  if (!t) return ''
  return t.substring(0, 16).replace('T', ' ')
}

const chooseImage = () => {
  uni.chooseImage({
    count: 9 - images.value.length,
    sizeType: ['compressed'],
    sourceType: ['album', 'camera'],
    success: (res) => {
      if (res.tempFilePaths) {
        images.value = images.value.concat(res.tempFilePaths)
      }
    }
  })
}

const removeImage = (index: number) => {
  images.value.splice(index, 1)
}

const selectOrder = (order: any) => {
  selectedOrder.value = order
  showOrderPicker.value = false
}

const selectType = (type: string) => {
  faultType.value = type
  showTypePicker.value = false
}

const loadOrders = async () => {
  try {
    const res = await getOrderList()
    const raw = (res.data as any) || {}
    // 兼容两种返回: {records: []} 或 数组
    const list: any[] = Array.isArray(raw)
      ? raw
      : (raw.records != null && Array.isArray(raw.records))
        ? raw.records
        : []
    orders.value = list.map((o: any) => ({
      id: o.id,
      orderNo: o.orderNo || o.order_no || '订单',
      droneId: o.droneId || o.drone_id,
      droneName: o.droneName || o.drone_name || o.droneModel || o.drone_model || '无人机',
      status: o.statusText || o.orderStatusDesc || o.status || o.order_status || '状态未知'
    }))
  } catch (err) {
    console.error('加载订单失败', err)
  }
}

const loadRecords = async () => {
  try {
    const res = await getFaultList()
    const raw = (res.data as any) || {}
    const list: any[] = Array.isArray(raw)
      ? raw
      : (raw.records != null && Array.isArray(raw.records))
        ? raw.records
        : []
    records.value = list.map((r: any) => ({
      id: r.id,
      faultType: r.faultType || r.fault_type || '故障',
      faultDescription: r.faultDescription || r.description || '',
      orderNo: r.orderNo || r.order_no,
      droneName: r.droneName || r.drone_name,
      status: r.status != null ? Number(r.status) : (r.auditStatus != null ? Number(r.auditStatus) : 0),
      createdTime: r.createdTime || r.created_time || ''
    }))
  } catch (err) {
    console.error('加载报修记录失败', err)
  }
}

const handleSubmit = async () => {
  if (!selectedOrder.value) {
    uni.showToast({ title: '请选择关联订单', icon: 'none' })
    return
  }
  if (!faultType.value) {
    uni.showToast({ title: '请选择故障类型', icon: 'none' })
    return
  }
  if (!description.value || description.value.trim().length < 5) {
    uni.showToast({ title: '请输入至少 5 字的故障描述', icon: 'none' })
    return
  }

  submitting.value = true
  try {
    await reportFault({
      droneId: selectedOrder.value.droneId,
      orderId: selectedOrder.value.id,
      faultType: faultType.value,
      faultDescription: description.value,
      faultImages: images.value.length > 0 ? images.value.join(',') : ''
    })
    uni.showToast({ title: '提交成功，等待处理', icon: 'success' })

    selectedOrder.value = null
    faultType.value = ''
    description.value = ''
    images.value = []
    faultDate.value = ''
    faultTime.value = ''

    setTimeout(() => {
      loadRecords()
    }, 800)
  } catch (err) {
    console.error('提交失败', err)
  } finally {
    submitting.value = false
  }
}

onMounted(() => {
  loadOrders()
  loadRecords()
})
</script>


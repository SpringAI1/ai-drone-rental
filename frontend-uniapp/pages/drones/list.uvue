<template>
  <view class="list-page">
    <!-- 顶部品牌区 -->
    <view class="list-header">
      <text class="list-title">设备浏览</text>
      <text class="list-subtitle">选择适合您需求的无人机设备</text>
    </view>

    <!-- 筛选区 -->
    <view class="filter-card">
      <view class="filter-row">
        <view class="filter-item" @click="openBrandPicker">
          <text class="filter-label">品牌</text>
          <view class="filter-value-wrap">
            <text class="filter-value">{{ selectedBrand || '全部品牌' }}</text>
            <text class="filter-arrow">▾</text>
          </view>
        </view>
        <view class="filter-item" @click="openTypePicker">
          <text class="filter-label">类型</text>
          <view class="filter-value-wrap">
            <text class="filter-value">{{ selectedType || '全部类型' }}</text>
            <text class="filter-arrow">▾</text>
          </view>
        </view>
      </view>
      <view class="filter-row">
        <view class="filter-item" @click="openPricePicker">
          <text class="filter-label">价格区间</text>
          <view class="filter-value-wrap">
            <text class="filter-value">{{ priceLabel }}</text>
            <text class="filter-arrow">▾</text>
          </view>
        </view>
        <view class="filter-item" @click="openStatusPicker">
          <text class="filter-label">状态</text>
          <view class="filter-value-wrap">
            <text class="filter-value">{{ statusLabel }}</text>
            <text class="filter-arrow">▾</text>
          </view>
        </view>
      </view>
      <view class="search-row">
        <view class="search-input-wrap">
          <text class="search-icon">🔍</text>
          <input
            class="search-input"
            v-model="keyword"
            placeholder="搜索设备名称"
            confirm-type="search"
            @confirm="handleSearch"
          />
        </view>
        <view class="search-btn" @click="handleSearch">
          <text class="search-btn-text">🔍搜索</text>
        </view>
      </view>
      <view class="filter-action">
        <view class="reset-btn" @click="handleReset">
          <text class="reset-btn-text">重置</text>
        </view>
      </view>
    </view>

    <!-- 排序区 -->
    <view class="sort-bar">
      <view class="sort-tabs">
        <view
          class="sort-tab"
          :class="{ active: sortBy === 'createdTime' }"
          @click="changeSort('createdTime')"
        >
          <text class="sort-tab-text">最新上架</text>
          <text class="sort-arrow">{{ sortBy === 'createdTime' ? (sortOrder === 'desc' ? '↓' : '↑') : '↓' }}</text>
        </view>
        <view
          class="sort-tab"
          :class="{ active: sortBy === 'pricePerDay' }"
          @click="changeSort('pricePerDay')"
        >
          <text class="sort-tab-text">价格</text>
          <text class="sort-arrow">{{ sortBy === 'pricePerDay' ? (sortOrder === 'desc' ? '↓' : '↑') : '↓' }}</text>
        </view>
        <view
          class="sort-tab"
          :class="{ active: sortBy === 'rentalCount' }"
          @click="changeSort('rentalCount')"
        >
          <text class="sort-tab-text">销量</text>
          <text class="sort-arrow">{{ sortBy === 'rentalCount' ? (sortOrder === 'desc' ? '↓' : '↑') : '↓' }}</text>
        </view>
      </view>
      <text class="sort-total">共 {{ totalCount }} 个设备</text>
    </view>

    <!-- 设备列表 网格布局 -->
    <view class="drone-grid" v-if="droneList.length > 0">
      <view
        class="drone-card"
        v-for="item in droneList"
        :key="item.id"
        @click="goToDetail(item.id)"
      >
        <view class="drone-card-img-box">
          <image class="drone-card-img" :src="item.image" mode="aspectFit" />
          <view class="drone-card-status">
            <view class="status-dot"></view>
            <text class="status-text">可租赁</text>
          </view>
        </view>
        <view class="drone-card-info">
          <text class="drone-card-name">{{ item.name }}</text>
          <text class="drone-card-brand">{{ item.brand }}</text>
          <view class="drone-card-specs">
            <view class="spec-item">
              <text class="spec-icon">⏱</text>
              <text class="spec-value">{{ item.flightTime }}分钟</text>
            </view>
            <view class="spec-divider"></view>
            <view class="spec-item">
              <text class="spec-icon">⚖</text>
              <text class="spec-value">{{ item.maxPayload }}kg</text>
            </view>
            <view class="spec-divider"></view>
            <view class="spec-item">
              <text class="spec-icon">⚡</text>
              <text class="spec-value">{{ item.maxSpeed }}km/h</text>
            </view>
          </view>
          <view class="drone-card-bottom">
            <view class="drone-card-price-col">
              <text class="drone-card-price">¥{{ item.price }}<text class="price-unit">/天</text></text>
              <text class="drone-card-stock">库存:{{ item.stock }}</text>
            </view>
            <view class="rent-btn" @click.stop="handleRent(item)">
              <text class="rent-btn-text">租赁</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空态 -->
    <view class="empty-state" v-else>
      <text class="empty-icon">🛸</text>
      <text class="empty-text">暂无符合条件的设备</text>
    </view>

    <view class="bottom-space"></view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed, onMounted } from 'vue'
import { getDroneList, getBrands, getTypes } from '../../api/drone'
import { resolveImageUrl } from '../../utils/image'

interface DroneDisplayItem {
  id: number
  name: string
  spec: string
  type: string
  price: number
  image: string
  brand: string
  stock: number
  flightTime: string
  maxPayload: string
  maxSpeed: string
  tagLeft: string
}

const keyword = ref<string>('')
const selectedBrand = ref<string>('')
const selectedType = ref<string>('')
const priceRange = ref<string>('')
const statusValue = ref<number>(1)
const sortBy = ref<string>('createdTime')
const sortOrder = ref<string>('desc')

const brands = ref<string[]>([])
const types = ref<string[]>([])

const droneList = ref<DroneDisplayItem[]>([])
const totalCount = ref<number>(0)

const priceOptions = [
  { label: '不限', value: '' },
  { label: '100元以下', value: '0-100' },
  { label: '100-300元', value: '100-300' },
  { label: '300-500元', value: '300-500' },
  { label: '500元以上', value: '500-99999' }
]

const statusOptions = [
  { label: '全部状态', value: -1 },
  { label: '可租赁', value: 1 },
  { label: '缺货', value: 0 },
  { label: '维护中', value: 2 }
]

const priceLabel = computed<string>(() => {
  const opt = priceOptions.find((o) => o.value === priceRange.value)
  return opt ? opt.label : '不限'
})

const statusLabel = computed<string>(() => {
  const opt = statusOptions.find((o) => o.value === statusValue.value)
  return opt ? opt.label : '全部状态'
})

const fallbackDrones: DroneDisplayItem[] = [
  { id: 1, name: 'DJI Mavic 3', spec: '旗舰航拍', type: '航拍', price: 299, image: resolveImageUrl('/uploads/mavic3_drone.png'), brand: 'DJI大疆', stock: 10, flightTime: '46', maxPayload: '0.9', maxSpeed: '75', tagLeft: 'DJI' },
  { id: 2, name: 'DJI Mini 3 Pro', spec: '轻便航拍', type: '航拍', price: 149, image: resolveImageUrl('/uploads/mini3pro_drone.png'), brand: 'DJI大疆', stock: 15, flightTime: '34', maxPayload: '0.25', maxSpeed: '58', tagLeft: 'DJI' },
  { id: 3, name: 'DJI Air 2S', spec: '一英寸传感', type: '航拍', price: 199, image: resolveImageUrl('/uploads/air2s_drone.png'), brand: 'DJI大疆', stock: 8, flightTime: '31', maxPayload: '0.6', maxSpeed: '68', tagLeft: 'DJI' },
  { id: 4, name: 'DJI Inspire 2', spec: '专业影视', type: '航拍', price: 599, image: resolveImageUrl('/uploads/inspire2_drone.png'), brand: 'DJI大疆', stock: 5, flightTime: '27', maxPayload: '1.4', maxSpeed: '94', tagLeft: 'DJI' },
  { id: 5, name: 'DJI Phantom 4 Pro', spec: '经典测绘', type: '测绘', price: 249, image: resolveImageUrl('/uploads/phantom4pro_drone.png'), brand: 'DJI大疆', stock: 6, flightTime: '30', maxPayload: '0.5', maxSpeed: '72', tagLeft: 'DJI' },
  { id: 6, name: 'DJI Agras T40', spec: '农业植保', type: '农业', price: 899, image: resolveImageUrl('/uploads/agrast40_drone.png'), brand: 'DJI大疆', stock: 3, flightTime: '25', maxPayload: '50', maxSpeed: '45', tagLeft: 'DJI' }
]

const fetchDrones = async () => {
  try {
    const params: any = {
      pageNum: 1,
      pageSize: 20,
      sortBy: sortBy.value,
      sortOrder: sortOrder.value
    }
    if (statusValue.value !== -1) {
      params.status = statusValue.value
    }
    if (selectedBrand.value) {
      params.brand = selectedBrand.value
    }
    if (selectedType.value) {
      params.type = selectedType.value
    }
    if (priceRange.value) {
      const parts = priceRange.value.split('-')
      if (parts.length === 2) {
        params.minPrice = Number(parts[0])
        params.maxPrice = Number(parts[1])
      }
    }
    if (keyword.value.trim().length > 0) {
      params.keyword = keyword.value.trim()
    }

    const res = await getDroneList(params)
    const records = (res.data as any)?.records || []
    totalCount.value = (res.data as any)?.total || records.length

    if (records.length === 0) {
      droneList.value = []
      return
    }

    droneList.value = records.map((d: any) => {
      const brand = d.brand || 'DJI大疆'
      const type = d.type || '航拍'
      const rawImage = d.image || '/uploads/mavic3_drone.png'
      const priceVal = d.pricePerDay !== undefined ? d.pricePerDay : (d.price || 0)
      const stockVal = d.stock !== undefined ? d.stock : 1
      const model = d.model || d.name || '无人机'

      return {
        id: d.id,
        name: model,
        spec: brand + ' · ' + type,
        type: type,
        price: priceVal,
        image: resolveImageUrl(rawImage),
        brand: brand,
        stock: stockVal,
        flightTime: d.flightTime ? String(d.flightTime) : '-',
        maxPayload: d.maxPayload !== undefined ? String(d.maxPayload) : '-',
        maxSpeed: d.maxSpeed !== undefined ? String(d.maxSpeed) : '-',
        tagLeft: brand
      }
    })
  } catch (err) {
    console.error('获取设备列表失败', err)
    droneList.value = fallbackDrones
    totalCount.value = fallbackDrones.length
  }
}

const fetchBrands = async () => {
  try {
    const res = await getBrands()
    brands.value = (res.data as any) || []
  } catch (err) {
    console.error('获取品牌列表失败', err)
  }
}

const fetchTypes = async () => {
  try {
    const res = await getTypes()
    types.value = (res.data as any) || []
  } catch (err) {
    console.error('获取类型列表失败', err)
  }
}

const handleSearch = () => {
  fetchDrones()
}

const handleReset = () => {
  keyword.value = ''
  selectedBrand.value = ''
  selectedType.value = ''
  priceRange.value = ''
  statusValue.value = 1
  sortBy.value = 'createdTime'
  sortOrder.value = 'desc'
  fetchDrones()
}

const openBrandPicker = () => {
  const items = ['全部品牌', ...brands.value]
  uni.showActionSheet({
    itemList: items,
    success: (res) => {
      if (res.tapIndex === 0) {
        selectedBrand.value = ''
      } else {
        selectedBrand.value = brands.value[res.tapIndex - 1] || ''
      }
      fetchDrones()
    }
  })
}

const openTypePicker = () => {
  const items = ['全部类型', ...types.value]
  uni.showActionSheet({
    itemList: items,
    success: (res) => {
      if (res.tapIndex === 0) {
        selectedType.value = ''
      } else {
        selectedType.value = types.value[res.tapIndex - 1] || ''
      }
      fetchDrones()
    }
  })
}

const openPricePicker = () => {
  const items = priceOptions.map((o) => o.label)
  uni.showActionSheet({
    itemList: items,
    success: (res) => {
      priceRange.value = priceOptions[res.tapIndex].value
      fetchDrones()
    }
  })
}

const openStatusPicker = () => {
  const items = statusOptions.map((o) => o.label)
  uni.showActionSheet({
    itemList: items,
    success: (res) => {
      statusValue.value = statusOptions[res.tapIndex].value
      fetchDrones()
    }
  })
}

const changeSort = (field: string) => {
  if (sortBy.value === field) {
    sortOrder.value = sortOrder.value === 'desc' ? 'asc' : 'desc'
  } else {
    sortBy.value = field
    sortOrder.value = 'desc'
  }
  fetchDrones()
}

const goToDetail = (id: number) => {
  uni.navigateTo({ url: '/pages/drone-detail/index?id=' + id })
}

const handleRent = (item: DroneDisplayItem) => {
  uni.navigateTo({ url: '/pages/drone-detail/index?id=' + item.id })
}

onMounted(() => {
  fetchBrands()
  fetchTypes()
  fetchDrones()
})
</script>

<style lang="scss">

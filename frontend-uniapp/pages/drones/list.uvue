.search-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 16rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #f8fafc;

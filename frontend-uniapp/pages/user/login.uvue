  background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 40%, #3b82f6 100%);
  border-radius: 55rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 36rpx rgba(37, 99, 235, 0.35);
  margin-bottom: 40rpx;
  transition: transform 0.2s, box-shadow 0.2s;
}

.submit-btn.loading {
  opacity: 0.7;
}

.submit-icon {
  font-size: 36rpx;

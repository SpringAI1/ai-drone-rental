.hero-section {
  position: relative;
  height: 520rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #1e3a8a 0%, #2563eb 40%, #3b82f6 70%, #60a5fa 100%);
}


  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.25);
}

.hero-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}

/* ===== 登录卡片 ===== */
.login-card {
  flex: 1;
  background: #ffffff;
  margin: -80rpx 40rpx 0;
  padding: 48rpx 40rpx 40rpx;
  border-radius: 40rpx 40rpx 24rpx 24rpx;
  box-shadow: 0 -20rpx 60rpx rgba(30, 58, 138, 0.15),
              0 20rpx 60rpx rgba(37, 99, 235, 0.08);
  position: relative;
  z-index: 2;
}

.card-title-box {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 48rpx;
}


<template>
  <view class="login-page">
    <!-- 顶部大图区 -->
    <view class="hero-section">
      <view class="hero-bg"></view>
      <image class="hero-image" src="/static/drones/mavic3_drone.png" mode="aspectFit" />
      <view class="hero-content">
        <text class="hero-title">AI 无人机租赁</text>
        <text class="hero-subtitle">✦ 开启您的飞行之旅 ✦</text>
      </view>
    </view>

    <!-- 登录表单卡片 -->
    <view class="login-card">
      <view class="card-title-box">
        <text class="card-title">欢迎回来</text>
        <text class="card-subtitle">登录您的账号继续飞行</text>
      </view>

      <!-- 用户名 -->
      <view class="form-item">
        <view class="input-box">
          <text class="input-icon">👤</text>
          <input
            class="form-input"
            v-model="username"
            placeholder="请输入用户名或邮箱"
            placeholderClass="input-placeholder"
            :confirm-type="'next'"
          />
        </view>
      </view>

      <!-- 密码 -->
      <view class="form-item">
        <view class="input-box">
          <text class="input-icon">🔒</text>
          <input
            class="form-input"
            v-model="password"
            placeholder="请输入密码"
            placeholderClass="input-placeholder"
            :password="!showPassword"
            :confirm-type="'done'"
          />
          <view class="eye-btn" @click="togglePassword">
            <text class="eye-icon">{{ showPassword ? '🙈' : '👁' }}</text>
          </view>
        </view>
      </view>

      <!-- 记住我 & 忘记密码 -->
      <view class="form-options">
        <view class="remember-box" @click="rememberMe = !rememberMe">
          <view class="checkbox" :class="{ checked: rememberMe }">
            <text v-if="rememberMe" class="check-icon">✓</text>
          </view>
          <text class="remember-text">记住我</text>
        </view>
        <text class="forgot-text" @click="handleForgot">忘记密码？</text>
      </view>

      <!-- 登录按钮 -->
      <view class="submit-btn" :class="{ loading: loading }" @click="handleLogin">
        <text class="submit-icon">✈</text>
        <text class="submit-text">{{ loading ? '登录中...' : '立即登录' }}</text>
      </view>

      <!-- 分隔线 -->
      <view class="divider-box">
        <view class="divider-line"></view>
        <text class="divider-text">或</text>
        <view class="divider-line"></view>
      </view>

      <!-- 注册链接 -->
      <view class="register-link-box">
        <text class="link-ask">还没有账号？</text>
        <text class="link-btn" @click="goToRegister">立即注册 →</text>
      </view>
    </view>

    <!-- 底部装饰 -->
    <view class="footer-decor">
      <text class="footer-text">探索 · 航拍 · 无限可能</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { login } from '../../api/auth'
import { getUserInfo } from '../../api/user'
import { useAuth } from '../../stores/auth'

const auth = useAuth()

const username = ref('')
const password = ref('')
const showPassword = ref(false)
const rememberMe = ref(false)
const loading = ref(false)

const togglePassword = () => {
  showPassword.value = !showPassword.value
}

const handleLogin = async () => {
  if (loading.value) return
  if (!username.value.trim()) {
    uni.showToast({ title: '请输入用户名', icon: 'none' })
    return
  }
  if (!password.value.trim()) {
    uni.showToast({ title: '请输入密码', icon: 'none' })
    return
  }

  loading.value = true
  try {
    const loginRes = await login({ username: username.value, password: password.value })
    const token = (loginRes.data as any)?.token || ''

    auth.setToken(token)

    let userInfo: any = null
    try {
      const userRes = await getUserInfo()
      userInfo = userRes.data
    } catch (err) {
      console.error('获取用户信息失败', err)
    }

    auth.login(token, userInfo)

    uni.showToast({ title: '登录成功', icon: 'success' })
    setTimeout(() => {
      uni.switchTab({ url: '/pages/index/index' })
    }, 800)
  } catch (err) {
    console.error('登录失败', err)
  } finally {
    loading.value = false
  }
}

const handleForgot = () => {
  uni.showToast({ title: '请联系客服找回密码', icon: 'none' })
}

const goToRegister = () => {
  uni.navigateTo({ url: '/pages/user/register' })
}
</script>


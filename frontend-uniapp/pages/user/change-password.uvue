<template>
  <view class="password-page">
    <view class="form-card">
      <view class="form-item">
        <text class="form-label">当前密码</text>
        <view class="input-wrap">
          <input
            class="form-input"
            :type="showOld ? 'text' : 'password'"
            v-model="oldPassword"
            placeholder="请输入当前密码"
            placeholder-class="input-placeholder"
          />
          <view class="toggle-eye" @click="showOld = !showOld">
            <text class="eye-text">{{ showOld ? '🙈' : '👁' }}</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">新密码</text>
        <view class="input-wrap">
          <input
            class="form-input"
            :type="showNew ? 'text' : 'password'"
            v-model="newPassword"
            placeholder="请输入新密码(6-20位)"
            placeholder-class="input-placeholder"
          />
          <view class="toggle-eye" @click="showNew = !showNew">
            <text class="eye-text">{{ showNew ? '🙈' : '👁' }}</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">确认密码</text>
        <view class="input-wrap">
          <input
            class="form-input"
            :type="showConfirm ? 'text' : 'password'"
            v-model="confirmPassword"
            placeholder="请再次输入新密码"
            placeholder-class="input-placeholder"
          />
          <view class="toggle-eye" @click="showConfirm = !showConfirm">
            <text class="eye-text">{{ showConfirm ? '🙈' : '👁' }}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="tip-box">
      <text class="tip-text">密码需为6-20位，建议使用字母+数字组合</text>
    </view>

    <view class="submit-box">
      <view class="submit-btn" :class="{ disabled: !canSubmit }" @click="handleSubmit">
        <text class="submit-text">{{ loading ? '提交中...' : '确认修改' }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { changePassword } from '../../api/user'

const oldPassword = ref<string>('')
const newPassword = ref<string>('')
const confirmPassword = ref<string>('')
const showOld = ref<boolean>(false)
const showNew = ref<boolean>(false)
const showConfirm = ref<boolean>(false)
const loading = ref<boolean>(false)

const canSubmit = computed<boolean>(() => {
  if (loading.value) return false
  if (!oldPassword.value || !newPassword.value || !confirmPassword.value) return false
  if (newPassword.value.length < 6 || newPassword.value.length > 20) return false
  if (newPassword.value !== confirmPassword.value) return false
  return true
})

const handleSubmit = async () => {
  if (!canSubmit.value) {
    if (newPassword.value !== confirmPassword.value) {
      uni.showToast({ title: '两次输入的密码不一致', icon: 'none' })
    } else if (newPassword.value.length < 6) {
      uni.showToast({ title: '密码至少6位', icon: 'none' })
    } else if (!oldPassword.value || !newPassword.value || !confirmPassword.value) {
      uni.showToast({ title: '请填写完整信息', icon: 'none' })
    }
    return
  }

  loading.value = true
  try {
    await changePassword({
      oldPassword: oldPassword.value,
      newPassword: newPassword.value
    })
    uni.showToast({ title: '密码修改成功', icon: 'success' })
    setTimeout(() => {
      uni.navigateBack()
    }, 1200)
  } catch (err) {
    console.error('修改密码失败', err)
  } finally {
    loading.value = false
  }
}
</script>

<style lang="scss">
page {
  min-height: 100vh;
  background: #f1f5f9;
}

.password-page {
  min-height: 100vh;
  background: #f1f5f9;
  padding: 20rpx 20rpx 0;
  box-sizing: border-box;
}

.form-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.form-item {
  display: flex;
  flex-direction: column;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f1f5f9;

  &:last-child {
    border-bottom: none;
  }
}

.form-label {
  font-size: 26rpx;
  color: #475569;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.input-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  box-sizing: border-box;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #0f172a;
  background: transparent;
  height: 44rpx;
}

.input-placeholder {
  color: #cbd5e1;
}

.toggle-eye {
  padding: 4rpx 8rpx;
  flex-shrink: 0;
}

.eye-text {
  font-size: 28rpx;
}

.tip-box {
  padding: 24rpx 12rpx;
}

.tip-text {
  font-size: 22rpx;
  color: #94a3b8;
}

.submit-box {
  margin: 40rpx 0;
  padding: 0 20rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  border-radius: 999rpx;
  padding: 26rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.25);

  &.disabled {
    background: #cbd5e1;
    box-shadow: none;
  }
}

.submit-text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 600;
  letter-spacing: 4rpx;
}
</style>

  display: block;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
}

.header-sub {
  display: block;
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 表单 */
.form-card {
  background: #ffffff;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.04);
}


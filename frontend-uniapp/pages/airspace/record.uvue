  font-size: 32rpx;
  color: #94a3b8;
}

/* 地址选择器 */
.address-picker-row {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.quick-address-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.quick-address-chip {
  background: #eff6ff;
  border: 2rpx solid #dbeafe;
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.chip-text {
  font-size: 22rpx;
  color: #2563eb;
}

/* 提交 */
.submit-box {
  padding: 20rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  border-radius: 999rpx;
  padding: 28rpx 0;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(99, 102, 241, 0.25);

  &.disabled {
    background: #cbd5e1;
    box-shadow: none;
  }
}

.submit-text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* 记录 */
.record-card {
  background: #ffffff;
  margin: 0 20rpx;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.04);
}

.record-title-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.record-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.record-total {
  font-size: 22rpx;
  color: #94a3b8;
}

.record-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f1f5f9;

  &:last-child {
    border-bottom: none;
  }
}

.record-header-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.record-name {
  font-size: 28rpx;
  color: #0f172a;
  font-weight: 600;
}

.status-tag {
  border-radius: 999rpx;
  padding: 4rpx 14rpx;

  &.status-0 {
    background: #fef3c7;
  }
  &.status-0 .status-text {
    color: #b45309;
  }

  &.status-1 {
    background: #dcfce7;
  }
  &.status-1 .status-text {
    color: #16a34a;
  }

  &.status-2 {
    background: #fee2e2;
  }
  &.status-2 .status-text {
    color: #dc2626;
  }
}

.status-text {
  font-size: 20rpx;
  font-weight: 500;
}

.record-info {
  display: block;
  font-size: 24rpx;
  color: #475569;

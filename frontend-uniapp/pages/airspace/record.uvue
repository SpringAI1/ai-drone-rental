  display: block;
  font-size: 26rpx;
  color: #475569;
  font-weight: 500;
  margin-bottom: 14rpx;
}

.form-input {
  width: 100%;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
  font-size: 28rpx;
  color: #0f172a;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 180rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
  font-size: 28rpx;
  color: #0f172a;
  box-sizing: border-box;
  line-height: 1.6;
}

.picker-row {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.picker-text {
  font-size: 28rpx;
  color: #0f172a;

  &.placeholder {
    color: #94a3b8;
  }
}


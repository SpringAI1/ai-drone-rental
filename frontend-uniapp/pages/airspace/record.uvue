  color: #ef4444;
  font-weight: 700;
  margin-left: 4rpx;
}

/* 顶部 */
.airspace-header {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  padding: 48rpx 32rpx 36rpx;
  border-radius: 0 0 32rpx 32rpx;
}

